# Environment variables for the Dummy agent.
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env        # Windows: copy .env.example .env
#
# `.env` is gitignored — never commit real keys. Values already present in the
# OS environment take precedence, so `setx`/shell exports keep working.

# ── Required ────────────────────────────────────────────
# SiliconFlow API key — used by the small/cheap classification model
# (workflow.llm.get_small_llm).
SILICONFLOW_API_KEY=

# DeepSeek API key — used to power main agent and worker agent
DEEPSEEK_API_KEY=

# ── Optional ────────────────────────────────────────────
# GitHub personal access token — only needed for the GitHub MCP tool.
GIT_API_KEY=

# Path to your Google OAuth client-secret JSON — only needed for the Google
# Calendar MCP tool (uncomment and point it at your downloaded file).
GOOGLE_OAUTH_CREDENTIALS=

# Override the preference-store path (default: preferences.json).
PREFERENCE_FILE=preferences.json
